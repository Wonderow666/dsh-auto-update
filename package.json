{
  "name": "dsh-auto-update",
  "version": "0.1.0",
  "description": "Check, install and roll back DeepSeek Harness CLI updates from the Web settings page, with a health-checked restart and automatic rollback.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "update",
    "upgrade"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "examples",
    "test",
    "apply-update.ps1",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/handler.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "win32"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
